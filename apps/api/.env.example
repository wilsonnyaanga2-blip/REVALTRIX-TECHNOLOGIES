WEB_APP_URL="https://app.yourdomain.com"
CORS_ORIGINS="http://localhost:5173"

# Use a transactional email provider and a sender domain you control.
# Publish the provider's SPF and DKIM records, plus a DMARC policy, in DNS.
SMTP_HOST=smtp.your-email-provider.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USERNAME=your-provider-username
SMTP_PASSWORD=your-provider-password
SMTP_FROM_EMAIL=notifications@yourdomain.com
SMTP_FROM_NAME=Revaltrix
