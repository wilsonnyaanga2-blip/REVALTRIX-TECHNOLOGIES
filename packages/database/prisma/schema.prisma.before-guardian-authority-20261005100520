generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RecordStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  ARCHIVED
}

enum PatientTenantRecordStatus {
  PENDING
  ACTIVE
  INACTIVE
  SUSPENDED
  ARCHIVED
}

enum TenantType {
  HOSPITAL
  CLINIC
  SPECIALIST_PRACTICE
  MEDICAL_CENTER
  DIAGNOSTIC_CENTER
  LABORATORY
  RADIOLOGY_CENTER
  PHARMACY
  DENTAL_CLINIC
  OPTICAL_CENTER
  MATERNITY_CENTER
  REHABILITATION_CENTER
  HOME_HEALTH_PROVIDER
  AMBULANCE_PROVIDER
  HEALTHCARE_NETWORK
  CORPORATE_HEALTH_PROVIDER
  INSURER
  EXTERNAL_PROVIDER
  OTHER_HEALTHCARE_PROVIDER
}

enum ProviderType {
  PHYSICIAN
  DENTIST
  NURSE
  MIDWIFE
  CLINICAL_OFFICER
  PHARMACIST
  PHARMACY_TECHNICIAN
  LABORATORY_SCIENTIST
  LABORATORY_TECHNICIAN
  RADIOLOGIST
  RADIOGRAPHER
  SONOGRAPHER
  PHYSIOTHERAPIST
  OCCUPATIONAL_THERAPIST
  NUTRITIONIST
  DIETITIAN
  PSYCHOLOGIST
  COUNSELLOR
  OPTOMETRIST
  OPTICIAN
  ANESTHESIOLOGIST
  SURGEON
  SPECIALIST
  PARAMEDIC
  OTHER
}

enum OrganizationType {
  HOSPITAL
  CLINIC
  DEPARTMENTAL_UNIT
  CORPORATE
  INSURER
  PARTNER
  OTHER
}

enum IdentityType {
  EMAIL
  PHONE
  NATIONAL_ID
  PASSPORT
  EXTERNAL
}

enum RegistrationType {
  TENANT
  PATIENT
}

enum RegistrationStatus {
  INITIATED
  VERIFICATION_REQUIRED
  ONBOARDING
  COMPLETED
  CANCELLED
  EXPIRED
}

enum VerificationStatus {
  PENDING
  PARTIALLY_VERIFIED
  VERIFIED
  FAILED
}

enum OnboardingStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
  REVOKED
  EXPIRED
}

enum RoleScope {
  PLATFORM
  TENANT
  ORGANIZATION
  BRANCH
  DEPARTMENT
}

enum PermissionEffect {
  ALLOW
  DENY
}

enum SessionStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum DeviceStatus {
  ACTIVE
  REVOKED
  BLOCKED
}

enum ApiKeyStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum TenantSetupStatus {
  NOT_STARTED
  IN_PROGRESS
  READY
  BLOCKED
  LIVE
  SUSPENDED
}

enum TenantDocumentStatus {
  DRAFT
  UPLOADED
  UNDER_REVIEW
  VERIFIED
  REJECTED
  EXPIRED
  REPLACED
}

enum TenantDocumentVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum TenantDocumentType {
  REGISTRATION_CERTIFICATE
  INCORPORATION_CERTIFICATE
  BUSINESS_PERMIT
  HEALTHCARE_FACILITY_LICENSE
  PROFESSIONAL_LICENSE
  TAX_CERTIFICATE
  INSURANCE_CERTIFICATE
  ACCREDITATION_CERTIFICATE
  MEDICAL_WASTE_CERTIFICATE
  FIRE_SAFETY_CERTIFICATE
  RADIATION_LICENSE
  PHARMACY_LICENSE
  LABORATORY_LICENSE
  AMBULANCE_LICENSE
  PRIVACY_DATA_PROTECTION_DOCUMENT
  OTHER
}

model User {
  id          String       @id @default(uuid()) @db.Uuid
  username    String?      @unique @db.VarChar(100)
  displayName String       @db.VarChar(200)
  status      RecordStatus @default(ACTIVE)

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  identities                         Identity[]
  memberships                        Membership[]
  sessions                           Session[]
  devices                            Device[]
  apiKeys                            ApiKey[]
  patientProfile                     PatientProfile?
  registrations                      Registration[]
  registrationSessions               RegistrationSession[]
  verificationChallenges             VerificationChallenge[]
  auditEvents                        AuditEvent[]                       @relation("AuditActor")
  securityEvents                     SecurityEvent[]                    @relation("SecurityActor")
  createdPatientRecords              PatientTenantRecord[]              @relation("PatientRecordCreator")
  patientDataSubmissions             PatientDataSubmission[]            @relation("PatientDataSubmitter")
  providerProfiles                   ProviderProfile[]
  encountersCreated                  Encounter[]                        @relation("EncounterCreator")
  encountersStatusChanged            EncounterStatusHistory[]           @relation("EncounterStatusChanger")
  patientAccessRequestsMade          PatientAccessRequest[]             @relation("PatientAccessRequestor")
  patientAccessRequestsReviewed      PatientAccessRequest[]             @relation("PatientAccessRequestReviewer")
  patientAccessGrantsCreated         PatientAccessGrant[]               @relation("PatientAccessGrantCreator")
  patientAccessLogs                  PatientDataAccessLog[]
  patientRelationshipRequestsMade    PatientTenantRelationshipRequest[] @relation("PatientRelationshipRequestor")
  patientRelationshipRequestsHandled PatientTenantRelationshipRequest[] @relation("PatientRelationshipRequestResponder")
  familyRelationshipRequestsMade     PatientFamilyRelationshipRequest[] @relation("FamilyRelationshipRequestCreator")
  familyRelationshipRequestsHandled  PatientFamilyRelationshipRequest[] @relation("FamilyRelationshipRequestResponder")
  familyRelationshipsCreated         PatientFamilyRelationship[]        @relation("FamilyRelationshipCreator")
  familyRelationshipsRevoked         PatientFamilyRelationship[]        @relation("FamilyRelationshipRevoker")
  patientDeletionRequestsMade        PatientDeletionRequest[]           @relation("PatientDeletionRequester")
  patientDeletionRequestsReviewed    PatientDeletionRequest[]           @relation("PatientDeletionReviewer")

  patientContactRecordsCreated    PatientContact[]          @relation("PatientContactCreator")
  patientContactRecordsUpdated    PatientContact[]          @relation("PatientContactUpdater")
  emergencyContactsCreated        EmergencyContact[]        @relation("EmergencyContactCreator")
  emergencyContactsUpdated        EmergencyContact[]        @relation("EmergencyContactUpdater")
  nextOfKinRecordsCreated         NextOfKin[]               @relation("NextOfKinCreator")
  nextOfKinRecordsUpdated         NextOfKin[]               @relation("NextOfKinUpdater")
  patientAddressesCreated         PatientAddress[]          @relation("PatientAddressCreator")
  patientAddressesUpdated         PatientAddress[]          @relation("PatientAddressUpdater")
  patientInsurancesCreated        PatientInsurance[]        @relation("PatientInsuranceCreator")
  patientInsurancesUpdated        PatientInsurance[]        @relation("PatientInsuranceUpdater")
  patientCorporateProfilesCreated PatientCorporateProfile[] @relation("PatientCorporateProfileCreator")
  patientCorporateProfilesUpdated PatientCorporateProfile[] @relation("PatientCorporateProfileUpdater")

  @@index([status])
  @@index([createdAt])
  @@map("users")
}

model Identity {
  id              String       @id @default(uuid()) @db.Uuid
  userId          String       @db.Uuid
  type            IdentityType
  value           String       @db.VarChar(320)
  normalizedValue String       @db.VarChar(320)
  credentialHash  String?      @db.VarChar(512)
  verifiedAt      DateTime?    @db.Timestamptz(6)
  status          RecordStatus @default(ACTIVE)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([type, normalizedValue])
  @@index([userId])
  @@index([type, normalizedValue])
  @@map("identities")
}

model ProviderProfile {
  id                 String       @id @default(uuid()) @db.Uuid
  tenantId           String       @db.Uuid
  userId             String       @db.Uuid
  providerNumber     String       @db.VarChar(100)
  providerType       ProviderType
  professionalTitle  String?      @db.VarChar(150)
  specialty          String?      @db.VarChar(200)
  subspecialty       String?      @db.VarChar(200)
  registrationNumber String?      @db.VarChar(150)
  registrationBody   String?      @db.VarChar(200)
  licenseNumber      String?      @db.VarChar(150)
  licenseExpiryDate  DateTime?    @db.Date
  status             RecordStatus @default(ACTIVE)
  createdAt          DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime     @updatedAt @db.Timestamptz(6)
  deletedAt          DateTime?    @db.Timestamptz(6)

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user       User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  encounters Encounter[]

  @@unique([tenantId, userId])
  @@unique([tenantId, providerNumber])
  @@index([tenantId, status])
  @@index([tenantId, providerType])
  @@index([userId, status])
  @@index([tenantId, specialty])
  @@map("provider_profiles")
}

model Encounter {
  id                    String  @id @default(uuid()) @db.Uuid
  tenantId              String  @db.Uuid
  patientTenantRecordId String  @db.Uuid
  providerId            String? @db.Uuid
  branchId              String? @db.Uuid
  departmentId          String? @db.Uuid
  createdByUserId       String  @db.Uuid

  encounterNumber String          @db.VarChar(100)
  type            EncounterType
  status          EncounterStatus @default(DRAFT)
  reason          String?         @db.VarChar(1000)

  startedAt       DateTime? @db.Timestamptz(6)
  completedAt     DateTime? @db.Timestamptz(6)
  cancelledAt     DateTime? @db.Timestamptz(6)
  cancelledReason String?   @db.VarChar(500)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  tenant              Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  patientTenantRecord PatientTenantRecord      @relation(fields: [patientTenantRecordId], references: [id], onDelete: Restrict)
  provider            ProviderProfile?         @relation(fields: [providerId], references: [id], onDelete: Restrict)
  branch              Branch?                  @relation(fields: [branchId], references: [id], onDelete: Restrict)
  department          Department?              @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  createdByUser       User                     @relation("EncounterCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  statusHistory       EncounterStatusHistory[]

  @@unique([tenantId, encounterNumber])
  @@index([tenantId, status])
  @@index([tenantId, patientTenantRecordId, createdAt])
  @@index([tenantId, providerId, status])
  @@index([tenantId, branchId, status])
  @@index([tenantId, departmentId, status])
  @@index([createdByUserId])
  @@map("encounters")
}

model EncounterStatusHistory {
  id              String           @id @default(uuid()) @db.Uuid
  encounterId     String           @db.Uuid
  tenantId        String           @db.Uuid
  fromStatus      EncounterStatus?
  toStatus        EncounterStatus
  changedByUserId String           @db.Uuid
  reason          String?          @db.VarChar(500)
  createdAt       DateTime         @default(now()) @db.Timestamptz(6)

  encounter     Encounter @relation(fields: [encounterId], references: [id], onDelete: Restrict)
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  changedByUser User      @relation("EncounterStatusChanger", fields: [changedByUserId], references: [id], onDelete: Restrict)

  @@index([encounterId, createdAt])
  @@index([tenantId, createdAt])
  @@index([changedByUserId, createdAt])
  @@map("encounter_status_history")
}

model Tenant {
  id        String       @id @default(uuid()) @db.Uuid
  type      TenantType
  name      String       @db.VarChar(200)
  legalName String?      @db.VarChar(300)
  code      String       @unique @db.VarChar(50)
  status    RecordStatus @default(ACTIVE)

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  organizations               Organization[]
  branches                    Branch[]
  departments                 Department[]
  memberships                 Membership[]
  roles                       Role[]
  permissions                 Permission[]
  registrations               Registration[]
  profile                     TenantProfile?
  setup                       TenantSetup?
  documents                   TenantDocument[]
  services                    Service[]
  patientRecords              PatientTenantRecord[]
  providers                   ProviderProfile[]
  auditEvents                 AuditEvent[]
  securityEvents              SecurityEvent[]
  patientDataSubmissions      PatientDataSubmission[]
  encounters                  Encounter[]
  encounterStatusHistory      EncounterStatusHistory[]
  patientAccessRequests       PatientAccessRequest[]
  patientAccessGrants         PatientAccessGrant[]
  patientAccessLogs           PatientDataAccessLog[]
  patientDeletionRequests     PatientDeletionRequest[]
  patientRelationshipRequests PatientTenantRelationshipRequest[]

  @@index([type])
  @@index([status])
  @@map("tenants")
}

model TenantProfile {
  id                      String  @id @default(uuid()) @db.Uuid
  tenantId                String  @unique @db.Uuid
  businessName            String? @db.VarChar(200)
  legalName               String? @db.VarChar(300)
  registrationNumber      String? @db.VarChar(150)
  taxIdentificationNumber String? @db.VarChar(150)
  country                 String  @db.VarChar(100)
  county                  String? @db.VarChar(100)
  subcounty               String? @db.VarChar(100)
  address                 String? @db.VarChar(500)
  postalCode              String? @db.VarChar(30)
  website                 String? @db.VarChar(500)
  contactEmail            String? @db.VarChar(320)
  contactPhone            String? @db.VarChar(50)
  description             String? @db.VarChar(1000)
  ownershipType           String? @db.VarChar(100)
  parentOrganizationId    String? @db.Uuid

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([country])
  @@index([county])
  @@map("tenant_profiles")
}

model TenantSetup {
  id               String            @id @default(uuid()) @db.Uuid
  tenantId         String            @unique @db.Uuid
  status           TenantSetupStatus @default(NOT_STARTED)
  readinessPercent Int               @default(0)
  readyAt          DateTime?         @db.Timestamptz(6)
  liveAt           DateTime?         @db.Timestamptz(6)
  suspendedAt      DateTime?         @db.Timestamptz(6)
  lastCalculatedAt DateTime?         @db.Timestamptz(6)
  createdAt        DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime          @updatedAt @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([status])
  @@map("tenant_setups")
}

model TenantDocument {
  id                 String                           @id @default(uuid()) @db.Uuid
  tenantId           String                           @db.Uuid
  type               TenantDocumentType
  status             TenantDocumentStatus             @default(DRAFT)
  verificationStatus TenantDocumentVerificationStatus @default(PENDING)
  title              String                           @db.VarChar(200)
  documentNumber     String?                          @db.VarChar(150)
  issuingAuthority   String?                          @db.VarChar(200)
  issueDate          DateTime?                        @db.Date
  expiryDate         DateTime?                        @db.Date
  version            Int                              @default(1)
  storageKey         String?                          @db.VarChar(1000)
  fileName           String?                          @db.VarChar(255)
  mimeType           String?                          @db.VarChar(150)
  fileSizeBytes      BigInt?
  checksum           String?                          @db.VarChar(128)
  uploadedByUserId   String?                          @db.Uuid
  verifiedByUserId   String?                          @db.Uuid
  verifiedAt         DateTime?                        @db.Timestamptz(6)
  rejectionReason    String?                          @db.VarChar(1000)
  createdAt          DateTime                         @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime                         @updatedAt @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId, type, status])
  @@index([tenantId, expiryDate])
  @@index([tenantId, verificationStatus])
  @@index([storageKey])
  @@map("tenant_documents")
}

model Service {
  id           String       @id @default(uuid()) @db.Uuid
  tenantId     String       @db.Uuid
  departmentId String?      @db.Uuid
  branchId     String?      @db.Uuid
  name         String       @db.VarChar(200)
  code         String       @db.VarChar(50)
  description  String?      @db.VarChar(1000)
  category     String?      @db.VarChar(100)
  durationMin  Int?
  status       RecordStatus @default(ACTIVE)

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  branch     Branch?     @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@index([tenantId, departmentId])
  @@index([tenantId, branchId])
  @@index([departmentId])
  @@index([branchId])
  @@map("services")
}

model Organization {
  id       String           @id @default(uuid()) @db.Uuid
  tenantId String           @db.Uuid
  parentId String?          @db.Uuid
  type     OrganizationType
  name     String           @db.VarChar(200)
  code     String           @db.VarChar(50)
  status   RecordStatus     @default(ACTIVE)

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  parent      Organization?  @relation("OrganizationHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children    Organization[] @relation("OrganizationHierarchy")
  branches    Branch[]
  departments Department[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([parentId])
  @@index([status])
  @@map("organizations")
}

model Branch {
  id             String       @id @default(uuid()) @db.Uuid
  tenantId       String       @db.Uuid
  organizationId String?      @db.Uuid
  name           String       @db.VarChar(200)
  code           String       @db.VarChar(50)
  status         RecordStatus @default(ACTIVE)

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  departments  Department[]
  memberships  Membership[]
  auditEvents  AuditEvent[]
  services     Service[]
  encounters   Encounter[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([organizationId])
  @@index([status])
  @@map("branches")
}

model Department {
  id             String       @id @default(uuid()) @db.Uuid
  tenantId       String       @db.Uuid
  organizationId String?      @db.Uuid
  branchId       String?      @db.Uuid
  parentId       String?      @db.Uuid
  name           String       @db.VarChar(200)
  code           String       @db.VarChar(50)
  status         RecordStatus @default(ACTIVE)

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch       Branch?       @relation(fields: [branchId], references: [id], onDelete: Restrict)
  parent       Department?   @relation("DepartmentHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children     Department[]  @relation("DepartmentHierarchy")
  memberships  Membership[]
  services     Service[]
  encounters   Encounter[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([organizationId])
  @@index([branchId])
  @@index([parentId])
  @@index([status])
  @@map("departments")
}

model Membership {
  id           String           @id @default(uuid()) @db.Uuid
  userId       String           @db.Uuid
  tenantId     String           @db.Uuid
  branchId     String?          @db.Uuid
  departmentId String?          @db.Uuid
  status       MembershipStatus @default(ACTIVE)

  startsAt  DateTime  @default(now()) @db.Timestamptz(6)
  endsAt    DateTime? @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)

  user       User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branch     Branch?          @relation(fields: [branchId], references: [id], onDelete: Restrict)
  department Department?      @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  roles      MembershipRole[]

  @@unique([userId, tenantId, branchId, departmentId])
  @@index([tenantId, status])
  @@index([userId, status])
  @@index([branchId])
  @@index([departmentId])
  @@map("memberships")
}

model Role {
  id          String       @id @default(uuid()) @db.Uuid
  tenantId    String?      @db.Uuid
  name        String       @db.VarChar(100)
  code        String       @db.VarChar(100)
  scope       RoleScope
  description String?      @db.VarChar(500)
  status      RecordStatus @default(ACTIVE)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  tenant      Tenant?          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  permissions RolePermission[]
  memberships MembershipRole[]

  @@unique([tenantId, code])
  @@index([tenantId, scope])
  @@index([status])
  @@map("roles")
}

model MembershipRole {
  membershipId String   @db.Uuid
  roleId       String   @db.Uuid
  assignedAt   DateTime @default(now()) @db.Timestamptz(6)

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Restrict)
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([membershipId, roleId])
  @@index([roleId])
  @@map("membership_roles")
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  tenantId    String?          @db.Uuid
  resource    String           @db.VarChar(150)
  action      String           @db.VarChar(100)
  effect      PermissionEffect @default(ALLOW)
  description String?          @db.VarChar(500)
  status      RecordStatus     @default(ACTIVE)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  tenant Tenant?          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  roles  RolePermission[]

  @@unique([tenantId, resource, action, effect])
  @@index([tenantId, resource])
  @@index([status])
  @@map("permissions")
}

model RolePermission {
  roleId       String   @db.Uuid
  permissionId String   @db.Uuid
  assignedAt   DateTime @default(now()) @db.Timestamptz(6)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model Session {
  id             String        @id @default(uuid()) @db.Uuid
  userId         String        @db.Uuid
  deviceId       String?       @db.Uuid
  tokenHash      String        @unique @db.VarChar(128)
  status         SessionStatus @default(ACTIVE)
  expiresAt      DateTime      @db.Timestamptz(6)
  lastActivityAt DateTime      @default(now()) @db.Timestamptz(6)
  createdAt      DateTime      @default(now()) @db.Timestamptz(6)
  revokedAt      DateTime?     @db.Timestamptz(6)

  user   User    @relation(fields: [userId], references: [id], onDelete: Restrict)
  device Device? @relation(fields: [deviceId], references: [id], onDelete: Restrict)

  @@index([userId, status])
  @@index([expiresAt])
  @@map("sessions")
}

model Device {
  id              String       @id @default(uuid()) @db.Uuid
  userId          String       @db.Uuid
  fingerprintHash String       @unique @db.VarChar(128)
  name            String?      @db.VarChar(150)
  platform        String?      @db.VarChar(50)
  status          DeviceStatus @default(ACTIVE)
