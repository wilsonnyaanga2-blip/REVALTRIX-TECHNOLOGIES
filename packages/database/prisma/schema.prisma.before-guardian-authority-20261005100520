  status             PatientDeletionRequestStatus @default(PENDING)
  reason             String                       @db.VarChar(1000)
  reviewReason       String?                      @db.VarChar(1000)
  requestedAt        DateTime                     @default(now()) @db.Timestamptz(6)
  reviewedAt         DateTime?                    @db.Timestamptz(6)
  completedAt        DateTime?                    @db.Timestamptz(6)
  createdAt          DateTime                     @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime                     @updatedAt @db.Timestamptz(6)

  patientProfile   PatientProfile @relation(fields: [patientProfileId], references: [id], onDelete: Restrict)
  requestingTenant Tenant?        @relation(fields: [requestingTenantId], references: [id], onDelete: Restrict)
  requestedByUser  User           @relation("PatientDeletionRequester", fields: [requestedByUserId], references: [id], onDelete: Restrict)
  reviewedByUser   User?          @relation("PatientDeletionReviewer", fields: [reviewedByUserId], references: [id], onDelete: Restrict)

  @@index([patientProfileId, status, createdAt])
  @@index([requestingTenantId, status, createdAt])
  @@index([requestedByUserId, createdAt])
  @@index([reviewedByUserId, createdAt])
  @@map("patient_deletion_requests")
}

model Registration {
  id                 String             @id @default(uuid()) @db.Uuid
  userId             String             @db.Uuid
  tenantId           String?            @db.Uuid
  type               RegistrationType
  status             RegistrationStatus @default(INITIATED)
  verificationStatus VerificationStatus @default(PENDING)
  onboardingStatus   OnboardingStatus   @default(NOT_STARTED)

  completedAt DateTime? @db.Timestamptz(6)
  expiresAt   DateTime? @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(6)

  user   User    @relation(fields: [userId], references: [id], onDelete: Restrict)
  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([userId, status])
  @@index([tenantId, status])
  @@index([type, status])
  @@index([verificationStatus])
  @@index([onboardingStatus])
  @@map("registrations")
}

model RegistrationSession {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String    @unique @db.VarChar(128)
  expiresAt  DateTime  @db.Timestamptz(6)
  consumedAt DateTime? @db.Timestamptz(6)
  lastUsedAt DateTime? @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@map("registration_sessions")
}

enum VerificationChannel {
  EMAIL
  PHONE
}

enum VerificationPurpose {
  REGISTRATION
  PASSWORD_RESET
}

model VerificationChallenge {
  id          String              @id @default(uuid()) @db.Uuid
  userId      String              @db.Uuid
  channel     VerificationChannel
  purpose     VerificationPurpose
  target      String              @db.VarChar(320)
  codeHash    String              @db.VarChar(128)
  expiresAt   DateTime            @db.Timestamptz(6)
  attempts    Int                 @default(0)
  maxAttempts Int                 @default(5)
  verifiedAt  DateTime?           @db.Timestamptz(6)
  consumedAt  DateTime?           @db.Timestamptz(6)
  createdAt   DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime            @updatedAt @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, purpose, channel])
  @@index([target, purpose])
  @@index([expiresAt])
  @@map("verification_challenges")
}
